# Variables de entorno del proceso. No se carga este archivo automáticamente.
# Predeterminado: SQLite local. Oracle necesita un servidor accesible.
DB_MODE=sqlite
PORT=3000
HOST=127.0.0.1
MQTT_PORT=18883
DATA_DIR=data
# ADMIN_PASSWORD solo se usa al crear la base de datos por primera vez.
# Si se omite, el programa genera una contraseña y la muestra en consola.
# ADMIN_PASSWORD=su_clave_inicial_de_al_menos_10_caracteres
# DB_MODE=oracle
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_CONNECT_STRING=servidor:1521/servicio
# COOKIE_SECURE=true solo al servir mediante HTTPS.
